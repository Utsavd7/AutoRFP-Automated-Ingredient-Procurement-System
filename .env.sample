# Copy to .env for local development. Never commit real credentials.

# PostgreSQL connection used by Prisma.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# NextAuth session configuration.
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Optional Google sign-in. Google is hidden unless both values are present.
# In Google Cloud Console, configure this callback URL:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
