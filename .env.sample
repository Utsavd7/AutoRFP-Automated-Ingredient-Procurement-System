# Copy to .env for local development. Never commit real credentials.

# Restricted application runtime through Supavisor transaction pooling.
# Create autorfp_app with the forced-RLS migration and store its password only
# in deployment secrets. Never run the web application as postgres.
DATABASE_URL="postgresql://autorfp_app.YOUR_PROJECT_REF:YOUR_APP_ROLE_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=3&sslmode=require"

# Privileged direct connection used only by Prisma migrations and operator
# recovery commands. Never expose this value to the running web application.
DIRECT_URL="postgresql://postgres:YOUR_ADMIN_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# NextAuth session configuration.
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Optional Google sign-in. Google is hidden unless both values are present.
# In Google Cloud Console, configure this callback URL:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
